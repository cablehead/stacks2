#!/bin/sh
# Builds dist/Stacks2.app and dist/Stacks2-<version>.dmg, signed with the
# Developer ID, and notarizes the disk image when a notarytool profile named
# stacks2 is saved in the keychain (xcrun notarytool store-credentials stacks2).
#
#   ./bundle            version 0.1.0
#   VERSION=0.2.0 ./bundle
set -e
cd "$(dirname "$0")"
version=${VERSION:-0.1.0}
identity="Developer ID Application: Andy Gayton (286QYU5E29)"
id=co.ndyg.stacks2

./build release

rm -rf dist
app=dist/stage/Stacks2.app
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp .build/release/Stacks2 "$app/Contents/MacOS/"
cp -R .build/release/stacks2_Stacks2.bundle "$app/Contents/Resources/"
cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key><string>$id</string>
  <key>CFBundleName</key><string>Stacks2</string>
  <key>CFBundleExecutable</key><string>Stacks2</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$version</string>
  <key>CFBundleVersion</key><string>$version</string>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>LSUIElement</key><true/>
  <key>NSHighResolutionCapable</key><true/>
</dict>
</plist>
PLIST
codesign --force --options runtime --timestamp --sign "$identity" "$app"
codesign --verify --strict --deep "$app"

ln -s /Applications dist/stage/Applications
dmg="dist/Stacks2-$version.dmg"
hdiutil create -quiet -volname Stacks2 -srcfolder dist/stage -ov -format UDZO "$dmg"
codesign --force --timestamp --sign "$identity" "$dmg"

if xcrun notarytool history --keychain-profile stacks2 >/dev/null 2>&1; then
  xcrun notarytool submit "$dmg" --keychain-profile stacks2 --wait
  xcrun stapler staple "$dmg"
else
  echo "not notarized: no notarytool profile named stacks2 (xcrun notarytool store-credentials stacks2)"
fi
mv dist/stage/Stacks2.app dist/
rm -rf dist/stage
echo "$dmg"
